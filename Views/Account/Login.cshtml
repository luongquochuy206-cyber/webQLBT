@model LoginVM
@{
    Layout = null;
    ViewData["Title"] = "Đăng nhập";
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Đăng nhập</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" />
</head>
<body class="login-page">
    <div class="login-card shadow">
        <div class="login-brand"><span class="brand-mark">U</span><span>UniFlow</span></div>
        <h2 class="text-center mb-2">Đăng nhập hệ thống</h2>
        <p class="login-caption">Cổng thông tin quản lý đào tạo tích hợp AI</p>
        <form asp-action="Login" method="post">
            <div asp-validation-summary="All" class="text-danger mb-3"></div>

            <div class="mb-3">
                <label class="form-label">Tên đăng nhập</label>
                <input asp-for="TenDangNhap" class="form-control" />
                <span asp-validation-for="TenDangNhap" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label class="form-label">Mật khẩu</label>
                <input asp-for="MatKhau" class="form-control" />
                <span asp-validation-for="MatKhau" class="text-danger"></span>
            </div>

            <button type="submit" class="btn btn-primary w-100 fw-bold">Đăng nhập</button>
        </form>

        <div class="mt-3 small text-muted">
            Tài khoản mặc định: <br />
            admin / admin123 <br />
            Sinh viên: dtc245200050 / 123456
        </div>
    </div>

    <partial name="_ValidationScriptsPartial" />
</body>
</html>
