@model IEnumerable<LichBaoTri>
@{ ViewData["Title"] = "Lịch bảo trì"; var devices = ViewBag.Devices as List<ThietBi> ?? new(); }
<div class="page-heading"><div><div class="eyebrow">KẾ HOẠCH BẢO DƯỠNG</div><h1>Lịch bảo trì</h1><p>Lên lịch định kỳ và cập nhật trạng thái công việc.</p></div></div>
<div class="content-grid schedule-layout"><section class="panel"><div class="panel-head"><div><h2>Danh sách lịch</h2><p>@Model.Count() lịch bảo trì</p></div></div><div class="schedule-list roomy">@if(!Model.Any()){<div class="empty-state">Chưa có lịch bảo trì. Tạo lịch ở biểu mẫu bên cạnh.</div>}@foreach(var x in Model){<div class="schedule-item"><div class="date-tile"><b>@x.NgayDuKien.ToString("dd")</b><span>@x.NgayDuKien.ToString("MMM")</span></div><div class="schedule-main"><b>@x.ThietBi?.Ten</b><small>@x.ThietBi?.KhuVuc · @x.NoiDung</small><small>@x.NhanVien · @x.ChiPhi.ToString("N0") đ</small><span class="badge-status @(x.TrangThai == "Hoàn tất" ? "success" : x.NgayDuKien < DateTime.Today && x.TrangThai != "Hoàn tất" ? "danger" : "warning")">@x.TrangThai</span></div>@if(x.TrangThai != "Hoàn tất"){<form asp-action="CompleteSchedule" method="post"><input type="hidden" name="id" value="@x.Id"/><button class="btn btn-sm btn-outline-primary">Hoàn tất</button></form>}</div>}</div></section>
<section class="panel form-panel"><h2>Lên lịch mới</h2><p class="section-caption">Tạo công việc bảo trì cho thiết bị.</p><form asp-action="CreateSchedule" method="post"><div class="mb-3"><label class="form-label">Thiết bị</label><select name="ThietBiId" class="form-select" required><option value="">Chọn thiết bị</option>@foreach(var d in devices){<option value="@d.Id">@d.MaThietBi — @d.Ten</option>}</select></div><div class="mb-3"><label class="form-label">Nội dung công việc</label><input name="NoiDung" class="form-control" required maxlength="160" placeholder="Kiểm tra định kỳ…"/></div><div class="mb-3"><label class="form-label">Ngày dự kiến</label><input name="NgayDuKien" type="date" class="form-control" required/></div><div class="mb-3"><label class="form-label">Nhân viên phụ trách</label><input name="NhanVien" class="form-control" value="Kỹ thuật viên"/></div><div class="mb-3"><label class="form-label">Chi phí dự kiến (đ)</label><input name="ChiPhi" type="number" min="0" class="form-control" value="0"/></div><button class="btn btn-primary w-100">＋ Tạo lịch bảo trì</button></form></section></div>
