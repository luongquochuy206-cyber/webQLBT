@model IEnumerable<ThietBi>
@{ ViewData["Title"] = "Thiết bị"; }
<div class="page-heading"><div><div class="eyebrow">TÀI SẢN TÒA NHÀ</div><h1>Thiết bị</h1><p>Danh mục thiết bị, khu vực và nhà cung cấp.</p></div><a class="btn btn-primary" asp-action="CreateDevice">＋ Thêm thiết bị</a></div>
<form class="toolbar" method="get"><input class="form-control" name="q" value="@ViewBag.Query" placeholder="Tìm tên, mã hoặc khu vực…"/><button class="btn btn-outline-primary">Tìm kiếm</button></form>
<div class="panel"><div class="table-responsive"><table class="table app-table"><thead><tr><th>Mã thiết bị</th><th>Tên</th><th>Khu vực</th><th>Nhà cung cấp</th><th>Trạng thái</th><th></th></tr></thead><tbody>@if(!Model.Any()){<tr><td colspan="6" class="empty-state">Chưa có thiết bị. Thêm thiết bị để bắt đầu quản lý.</td></tr>}@foreach(var x in Model){<tr><td>@x.MaThietBi</td><td class="fw-semibold">@x.Ten</td><td>@x.KhuVuc</td><td>@x.NhaCungCap</td><td><span class="badge-status @(x.TrangThai == "Hoạt động" ? "success" : "warning")">@x.TrangThai</span></td><td class="text-end"><a class="btn btn-sm btn-outline-secondary" asp-action="EditDevice" asp-route-id="@x.Id">Sửa</a> <form class="d-inline" asp-action="DeleteDevice" asp-route-id="@x.Id" method="post"><button class="btn btn-sm btn-outline-danger" onclick="return confirm('Xóa thiết bị này?')">Xóa</button></form></td></tr>}</tbody></table></div></div>
