@model IEnumerable<ThietBi>
@{ ViewData["Title"] = "Trợ lý AI"; }
<div class="page-heading"><div><div class="eyebrow">AI MAINTENANCE ASSISTANT</div><h1>Trợ lý bảo trì</h1><p>Phân tích lịch sử thiết bị để hỗ trợ kỹ thuật viên ra quyết định.</p></div></div><div class="content-grid assistant-grid"><section class="panel assistant-panel"><div class="assistant-title"><div class="ai-orb">✦</div><div><h2>Phân tích thiết bị</h2><p>Chọn thiết bị để xem tóm tắt tình trạng và lịch sử gần đây.</p></div></div><form asp-action="AskAssistant" method="post"><div class="mb-3"><label class="form-label">Thiết bị cần phân tích</label><select name="thietBiId" class="form-select" required><option value="">Chọn thiết bị</option>@foreach(var d in Model){<option value="@d.Id">@d.MaThietBi — @d.Ten (@d.KhuVuc)</option>}</select></div><div class="mb-3"><label class="form-label">Câu hỏi (tùy chọn)</label><input name="question" class="form-control" placeholder="VD: Cần ưu tiên kiểm tra điều gì?"/></div><button class="btn btn-primary">✦ Tạo phân tích</button></form>@if(TempData["AiResult"] != null){<div class="ai-result"><b>Tóm tắt & gợi ý</b><p>@TempData["AiResult"]</p></div>}</section><section class="panel"><h2>Phạm vi & giới hạn</h2><ul class="ai-rules"><li>Chỉ tổng hợp dữ liệu thiết bị, lịch bảo trì và phiếu sự cố trong hệ thống.</li><li>Gợi ý mức độ sự cố là phân loại sơ bộ theo từ khóa, cần nhân viên xác nhận.</li><li>Bản demo chưa gọi API AI bên ngoài; không cần API key.</li><li>Không dùng gợi ý làm căn cứ duy nhất cho thao tác an toàn hoặc sửa chữa.</li></ul><div class="prompt-box"><small>SYSTEM PROMPT MẪU</small><p>Bạn là trợ lý bảo trì. Chỉ sử dụng dữ liệu được cung cấp. Nêu rõ thông tin chưa đủ, không tự suy đoán thông số kỹ thuật và luôn yêu cầu kỹ thuật viên xác nhận.</p></div></section></div>
