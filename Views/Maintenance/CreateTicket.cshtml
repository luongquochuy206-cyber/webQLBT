@model PhieuSuCo
@{ ViewData["Title"] = "Tạo phiếu sự cố"; var devices = ViewBag.Devices as List<ThietBi> ?? new(); }
<div class="page-heading"><div><div class="eyebrow">TIẾP NHẬN SỰ CỐ</div><h1>Tạo phiếu sự cố</h1><p>Mức độ ưu tiên được gợi ý tự động theo nội dung mô tả.</p></div></div><div class="panel form-panel"><form asp-action="CreateTicket" method="post"><div asp-validation-summary="ModelOnly" class="text-danger"></div><div class="form-grid"><div class="mb-3"><label class="form-label">Thiết bị</label><select asp-for="ThietBiId" class="form-select"><option value="">Chọn thiết bị</option>@foreach(var d in devices){<option value="@d.Id">@d.MaThietBi — @d.Ten (@d.KhuVuc)</option>}</select><span asp-validation-for="ThietBiId" class="text-danger"></span></div><div class="mb-3"><label asp-for="TieuDe" class="form-label">Tiêu đề sự cố</label><input asp-for="TieuDe" class="form-control" placeholder="VD: Điều hòa tầng 3 không chạy"/><span asp-validation-for="TieuDe" class="text-danger"></span></div><div class="mb-3"><label asp-for="NguoiBao" class="form-label">Người báo</label><input asp-for="NguoiBao" class="form-control"/></div><div class="mb-3"><label asp-for="NhanVienXuLy" class="form-label">Nhân viên xử lý</label><input asp-for="NhanVienXuLy" class="form-control" value="Chưa phân công"/></div><div class="mb-3 full"><label asp-for="MoTa" class="form-label">Mô tả chi tiết</label><textarea asp-for="MoTa" class="form-control" rows="4" placeholder="Mô tả hiện tượng, thời điểm và ảnh hưởng…"></textarea><span asp-validation-for="MoTa" class="text-danger"></span></div></div><button class="btn btn-primary">Tiếp nhận sự cố</button> <a class="btn btn-outline-secondary" asp-action="Tickets">Hủy</a></form></div>
