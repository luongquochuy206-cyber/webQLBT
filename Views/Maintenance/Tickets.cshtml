@model IEnumerable<PhieuSuCo>
@{ ViewData["Title"] = "Phiếu sự cố"; }
<div class="page-heading"><div><div class="eyebrow">TIẾP NHẬN & XỬ LÝ</div><h1>Phiếu sự cố</h1><p>Theo dõi mức độ ưu tiên, người phụ trách và trạng thái xử lý.</p></div><a class="btn btn-primary" asp-action="CreateTicket">＋ Tạo phiếu sự cố</a></div>
<form class="toolbar" method="get"><input class="form-control" name="q" value="@ViewBag.Query" placeholder="Tìm tiêu đề, thiết bị, trạng thái…"/><button class="btn btn-outline-primary">Tìm kiếm</button></form><div class="panel"><div class="table-responsive"><table class="table app-table"><thead><tr><th>Sự cố / thiết bị</th><th>Mức độ</th><th>Người xử lý</th><th>Trạng thái</th><th>Ngày tạo</th><th>Cập nhật</th></tr></thead><tbody>@if(!Model.Any()){<tr><td colspan="6" class="empty-state">Chưa có phiếu sự cố.</td></tr>}@foreach(var x in Model){<tr><td><b>@x.TieuDe</b><small class="table-sub">@x.ThietBi?.MaThietBi · @x.ThietBi?.Ten</small><small class="table-sub">@x.MoTa</small></td><td><span class="badge-status @(x.MucDo == "Cao" ? "danger" : x.MucDo == "Trung bình" ? "warning" : "success")">@x.MucDo</span></td><td>@x.NhanVienXuLy</td><td>@x.TrangThai</td><td>@x.NgayTao.ToString("dd/MM/yyyy HH:mm")</td><td><form asp-action="UpdateTicket" method="post" class="quick-edit"><input type="hidden" name="id" value="@x.Id"/><select name="trangThai" class="form-select form-select-sm"><option selected="@(x.TrangThai == "Mới tiếp nhận")">Mới tiếp nhận</option><option selected="@(x.TrangThai == "Đang xử lý")">Đang xử lý</option><option selected="@(x.TrangThai == "Chờ vật tư")">Chờ vật tư</option><option selected="@(x.TrangThai == "Hoàn tất")">Hoàn tất</option></select><input name="nhanVienXuLy" value="@x.NhanVienXuLy" class="form-control form-control-sm"/><button class="btn btn-sm btn-primary">Lưu</button></form></td></tr>}</tbody></table></div></div>
