@model List<MaVe>
@{
    ViewData["Title"] = "Mã vé";
}
<div class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="page-title mb-0">Quản lý mã vé</h2>
    <a asp-action="Create" class="btn btn-warning fw-bold">+ Thêm mã vé</a>
</div>

<form method="get" class="mb-3">
    <input name="keyword" class="form-control" placeholder="Tìm theo mã vé hoặc loại vé..." />
</form>

<div class="table-responsive">
    <table class="table table-bordered table-hover">
        <thead class="table-warning">
            <tr>
                <th>Mã vé</th>
                <th>Loại</th>
                <th>Trạng thái</th>
                <th>Ghi chú</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.MaVeCode</td>
                    <td>@item.LoaiMaVe</td>
                    <td>@item.TrangThai</td>
                    <td>@item.GhiChu</td>
                </tr>
            }
        </tbody>
    </table>
</div>