@using QLBaiGuiXe.Models
@{ ViewData["Title"]="Đăng ký học phần"; var student=ViewBag.Student as SinhVien; var classes=ViewBag.OpenClasses as List<LopHocPhan> ?? new(); var enrolled=ViewBag.Enrolled as List<DangKyHocPhan> ?? new(); }
<div class="page-title-row"><div><div class="eyebrow">HỌC KỲ 2026 – 2027 · HỌC KỲ 1</div><h1>Đăng ký học phần</h1><p>Chọn lớp phù hợp. Hệ thống tự kiểm tra tiên quyết, sĩ số và lịch trùng.</p></div><div class="student-mini"><div class="avatar">Đ</div><div><b>@student?.HoTen</b><small>@student?.MaSinhVien</small></div></div></div>
<div class="registration-grid"><section class="surface-card"><div class="section-head"><div><h2>Các lớp đang mở</h2><p>@classes.Count lớp học phần</p></div><span class="status-pill active">● Đăng ký mở</span></div><div class="course-list">@foreach(var c in classes){var registered=enrolled.Any(x=>x.LopHocPhanId==c.Id);<div class="course-row"><div class="course-mark">@c.HocPhan?.MaHocPhan?.Substring(0,Math.Min(2,c.HocPhan.MaHocPhan.Length))</div><div class="course-data"><div><span class="code-tag">@c.MaLop</span> <span class="credits">@c.HocPhan?.TinChi tín chỉ</span></div><h3>@c.HocPhan?.TenHocPhan</h3><p>@c.GiangVien · Thứ @c.Thu, tiết @c.TietBatDau–@(c.TietBatDau+c.SoTiet-1) · @c.Phong</p>@if(c.HocPhan?.MaTienQuyet != null){<small class="prereq">◈ Tiên quyết: @c.HocPhan.MaTienQuyet</small>}</div><div class="course-action"><small>@c.DangKys.Count/@c.SiSoToiDa chỗ</small>@if(registered){<button class="button-outline" disabled>Đã đăng ký</button>}else{<form method="post" asp-action="Register"><input type="hidden" name="classId" value="@c.Id"/><button class="button-primary" disabled="@(c.DangKys.Count>=c.SiSoToiDa)">Đăng ký</button></form>}</div></div>}</div></section>
<aside class="surface-card enrolled-card"><div class="section-head"><div><h2>Lớp của tôi</h2><p>@enrolled.Count lớp đã đăng ký</p></div></div>@if(enrolled.Count==0){<p class="empty-state">Bạn chưa đăng ký lớp nào.</p>}@foreach(var e in enrolled){<div class="enrolled-row"><div><b>@e.LopHocPhan?.HocPhan?.TenHocPhan</b><small>@e.LopHocPhan?.MaLop · @e.LopHocPhan?.HocPhan?.TinChi TC</small></div><span class="status-dot">●</span></div>}<div class="policy-note"><b>ⓘ Lưu ý đăng ký</b><p>Đăng ký chỉ thành công khi còn chỗ, đủ điều kiện tiên quyết và không trùng lịch học.</p></div></aside></div>
