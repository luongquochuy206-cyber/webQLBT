@model List<QLBaiGuiXe.Models.DangKyHocPhan>
@{ ViewData["Title"]="Kết quả học tập"; var student=ViewBag.Student as QLBaiGuiXe.Models.SinhVien; var scored=Model.Where(x=>x.DiemTongKet.HasValue).ToList(); }
<div class="page-title-row"><div><div class="eyebrow">HỒ SƠ HỌC TẬP CÁ NHÂN</div><h1>Kết quả học tập</h1><p>Bảng điểm và tiến độ tích lũy của @student?.HoTen.</p></div><span class="code-tag">@student?.MaSinhVien</span></div>
<div class="grade-summary"><div class="grade-card"><small>ĐIỂM TRUNG BÌNH</small><strong>@(scored.Count==0?"—":scored.Average(x=>x.DiemTongKet)!.Value.ToString("0.00"))</strong><span>Thang điểm 10</span></div><div class="grade-card"><small>HỌC PHẦN HOÀN THÀNH</small><strong>@scored.Count</strong><span>Tổng @Model.Count học phần đã đăng ký</span></div><div class="grade-card"><small>TÍN CHỈ ĐẠT</small><strong>@Model.Where(x=>x.DiemTongKet>=4).Sum(x=>x.LopHocPhan?.HocPhan?.TinChi ?? 0)</strong><span>Tín chỉ tích lũy</span></div></div>
<section class="surface-card"><div class="section-head"><div><h2>Bảng điểm chi tiết</h2><p>Điểm tổng kết = 40% quá trình + 60% thi</p></div></div><div class="table-responsive"><table class="table clean-table"><thead><tr><th>MÃ HỌC PHẦN</th><th>TÊN HỌC PHẦN</th><th>TÍN CHỈ</th><th>QUÁ TRÌNH</th><th>THI</th><th>TỔNG KẾT</th><th>KẾT QUẢ</th>@if(User.IsInRole("Admin")||User.IsInRole("GiangVien")){<th>CẬP NHẬT ĐIỂM</th>}</tr></thead><tbody>@foreach(var x in Model){<tr><td><span class="code-tag">@x.LopHocPhan?.HocPhan?.MaHocPhan</span></td><td><b>@x.LopHocPhan?.HocPhan?.TenHocPhan</b></td><td>@x.LopHocPhan?.HocPhan?.TinChi</td><td>@(x.DiemQuaTrinh?.ToString("0.0") ?? "—")</td><td>@(x.DiemThi?.ToString("0.0") ?? "—")</td><td><b>@(x.DiemTongKet?.ToString("0.0") ?? "—")</b></td><td>@if(x.DiemTongKet.HasValue){<span class="status-pill @(x.DiemTongKet>=4?"done":"failed")">@(x.DiemTongKet>=4?"Đạt":"Chưa đạt")</span>}else{<span class="status-pill pending">Đang học</span>}</td>@if(User.IsInRole("Admin")||User.IsInRole("GiangVien")){<td><form method="post" asp-action="SaveGrade" class="grade-edit"><input type="hidden" name="id" value="@x.Id"/><input name="diemQuaTrinh" type="number" min="0" max="10" step="0.1" value="@x.DiemQuaTrinh" placeholder="QT"/><input name="diemThi" type="number" min="0" max="10" step="0.1" value="@x.DiemThi" placeholder="Thi"/><button class="button-outline">Lưu</button></form></td>}</tr>}</tbody></table></div></section>
<div class="ai-callout grade-ai"><div class="ai-symbol">✧</div><div><b>Muốn hiểu rõ tiến độ học tập?</b><p>UniFlow AI có thể tóm tắt điểm số và đề xuất kế hoạch cải thiện.</p></div><a class="button-light" asp-action="Assistant">Nhận tư vấn →</a></div>
