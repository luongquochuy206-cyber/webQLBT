@{ ViewData["Title"]="AI tư vấn học tập"; }
<div class="page-title-row"><div><div class="eyebrow">UNIFLOW AI · TRỢ LÝ HỌC VỤ</div><h1>Xin chào, mình có thể giúp gì?</h1><p>Hỏi về đăng ký môn học, điều kiện tiên quyết hoặc kết quả học tập.</p></div><span class="ai-live"><i></i> Trợ lý sẵn sàng</span></div>
<div class="assistant-layout"><section class="surface-card chat-card"><div class="chat-head"><div class="ai-symbol">✧</div><div><b>Trợ lý học vụ UniFlow</b><small>Hỗ trợ dựa trên dữ liệu đào tạo</small></div><span class="ai-live"><i></i> Trực tuyến</span></div><div class="chat-body"><div class="bot-message"><b>Chào bạn! 👋</b><p>Mình có thể giúp bạn tra cứu điều kiện đăng ký, xem lịch học hoặc tóm tắt kết quả học tập. Bạn muốn tìm hiểu điều gì?</p></div>@if(ViewBag.Answer!=null){<div class="user-message">@ViewBag.Question</div><div class="bot-message"><b>✧ UniFlow AI</b><p>@ViewBag.Answer</p>@if(ViewBag.AiNotice!=null){<small>@ViewBag.AiNotice</small>}<small>Hãy đối chiếu thông tin quy chế với phòng đào tạo khi cần.</small></div>}</div><form method="post" class="chat-input"><input name="question" value="" placeholder="Nhập câu hỏi của bạn..." required/><button class="button-primary" aria-label="Gửi">↑</button></form><div class="chat-foot">AI có thể mắc lỗi. Trợ lý không thay thế quyết định chính thức của phòng đào tạo.</div></section>
<aside class="surface-card suggestions"><h2>Gợi ý câu hỏi</h2><p>Chọn một chủ đề để bắt đầu</p><button type="button" onclick="ask('Tôi nên đăng ký học phần nào?')"><span>▤</span><b>Tư vấn đăng ký học phần</b><small>Xem môn phù hợp và điều kiện tiên quyết</small><i>→</i></button><button type="button" onclick="ask('Hãy tóm tắt kết quả học tập của tôi')"><span>◫</span><b>Tóm tắt kết quả học tập</b><small>Phân tích điểm và gợi ý cải thiện</small><i>→</i></button><button type="button" onclick="ask('Quy chế đăng ký học phần như thế nào?')"><span>ⓘ</span><b>Hỏi về quy chế đào tạo</b><small>Tra cứu hướng dẫn học vụ</small><i>→</i></button><div class="privacy-note">♧ <span>Dữ liệu cá nhân chỉ được dùng trong phạm vi tư vấn học tập của bạn.</span></div></aside></div>
@section Scripts { <script>function ask(text){const input=document.querySelector('.chat-input input');input.value=text;input.form.requestSubmit();}</script> }
