@model List<QLBaiGuiXe.Models.SinhVien>
@{ ViewData["Title"]="Sinh viên"; }
<div class="page-title-row"><div><div class="eyebrow">HỒ SƠ &amp; DANH SÁCH</div><h1>Quản lý sinh viên</h1><p>Tra cứu hồ sơ, ngành học và lớp hành chính.</p></div><button class="button-primary" data-bs-toggle="modal" data-bs-target="#addStudent">＋ Thêm sinh viên</button></div>
<section class="surface-card"><form method="get" class="filter-bar"><div class="search-field">⌕ <input name="q" value="@ViewBag.Query" placeholder="Tìm mã sinh viên, họ tên, ngành..." /></div><button class="button-outline">Tìm kiếm</button><span class="result-count">@Model.Count sinh viên</span></form><div class="table-responsive"><table class="table clean-table"><thead><tr><th>MÃ SINH VIÊN</th><th>HỌ VÀ TÊN</th><th>NGÀNH ĐÀO TẠO</th><th>LỚP HÀNH CHÍNH</th><th>EMAIL</th><th>KHÓA</th></tr></thead><tbody>@foreach(var s in Model){<tr><td><span class="code-tag">@s.MaSinhVien</span></td><td><div class="person-cell"><div class="avatar">@s.HoTen.FirstOrDefault()</div><b>@s.HoTen</b></div></td><td>@s.Nganh</td><td>@s.LopHanhChinh</td><td>@s.Email</td><td>K@s.Khoa</td></tr>}</tbody></table></div></section>
<div class="modal fade" id="addStudent" tabindex="-1"><div class="modal-dialog"><form class="modal-content" method="post" action="/Academic/SaveStudent">@Html.AntiForgeryToken()<div class="modal-header"><h5>Thêm hồ sơ sinh viên</h5><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div><div class="modal-body"><label class="form-label">Mã sinh viên</label><input class="form-control mb-3" name="MaSinhVien" required/><label class="form-label">Họ và tên</label><input class="form-control mb-3" name="HoTen" required/><label class="form-label">Email</label><input class="form-control mb-3" type="email" name="Email"/><label class="form-label">Ngành</label><input class="form-control mb-3" name="Nganh" value="Công nghệ thông tin"/><label class="form-label">Lớp hành chính</label><input class="form-control mb-3" name="LopHanhChinh"/><label class="form-label">Khóa</label><input class="form-control" type="number" name="Khoa" value="23"/></div><div class="modal-footer"><button class="button-primary">Lưu hồ sơ</button></div></form></div></div>

