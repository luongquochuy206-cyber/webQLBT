@model List<QLBaiGuiXe.Models.HocPhan>
@{ ViewData["Title"]="Học phần & lớp"; var classes=ViewBag.Classes as List<QLBaiGuiXe.Models.LopHocPhan> ?? new(); }
<div class="page-title-row"><div><div class="eyebrow">CHƯƠNG TRÌNH ĐÀO TẠO</div><h1>Học phần &amp; lớp học</h1><p>Danh mục học phần, điều kiện tiên quyết và các lớp đang mở.</p></div><a class="button-primary" asp-action="Enrollments">Đến trang đăng ký →</a></div>
<section class="surface-card mb-4"><div class="section-head"><div><h2>Danh mục học phần</h2><p>@Model.Count học phần trong hệ thống</p></div><form method="get" class="search-field">⌕ <input name="q" value="@ViewBag.Query" placeholder="Tìm học phần..." /></form></div><div class="table-responsive"><table class="table clean-table"><thead><tr><th>MÃ HỌC PHẦN</th><th>TÊN HỌC PHẦN</th><th>TÍN CHỈ</th><th>TIÊN QUYẾT</th><th>KHOA QUẢN LÝ</th></tr></thead><tbody>@foreach(var c in Model){<tr><td><span class="code-tag">@c.MaHocPhan</span></td><td><b>@c.TenHocPhan</b></td><td>@c.TinChi TC</td><td>@(c.MaTienQuyet ?? "Không")</td><td>@c.KhoaQuanLy</td></tr>}</tbody></table></div></section>
<section class="surface-card"><div class="section-head"><div><h2>Lớp học phần đang mở</h2><p>Lịch học và tình trạng sĩ số</p></div></div><div class="table-responsive"><table class="table clean-table"><thead><tr><th>MÃ LỚP</th><th>HỌC PHẦN</th><th>GIẢNG VIÊN</th><th>LỊCH HỌC</th><th>PHÒNG</th><th>SĨ SỐ</th></tr></thead><tbody>@foreach(var c in classes){<tr><td><span class="code-tag">@c.MaLop</span></td><td><b>@c.HocPhan?.TenHocPhan</b><small class="table-sub">@c.HocPhan?.TinChi tín chỉ · @(c.HocPhan?.MaTienQuyet == null ? "Không yêu cầu tiên quyết" : "Tiên quyết: " + c.HocPhan.MaTienQuyet)</small></td><td>@c.GiangVien</td><td>Thứ @c.Thu, tiết @c.TietBatDau–@(c.TietBatDau+c.SoTiet-1)</td><td>@c.Phong</td><td><div class="capacity"><span>@c.DangKys.Count/@c.SiSoToiDa</span><div><i style="width:@(Math.Min(100,c.DangKys.Count*100/Math.Max(c.SiSoToiDa,1)))%"></i></div></div></td></tr>}</tbody></table></div></section>
