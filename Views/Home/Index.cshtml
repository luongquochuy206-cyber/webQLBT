@using QLBaiGuiXe.Models
@{ ViewData["Title"]="Tổng quan"; var recent=ViewBag.RecentEnrollments as List<DangKyHocPhan> ?? new(); var sections=ViewBag.OpenSections as List<LopHocPhan> ?? new(); }
<div class="welcome-row"><div><div class="eyebrow">THỨ HAI, HỌC KỲ 2026 – 2027</div><h1>Chào buổi sáng, @User.FindFirst("HoTen")?.Value 👋</h1><p>Đây là những gì đang diễn ra trong hệ thống đào tạo hôm nay.</p></div><a class="button-primary" asp-controller="Academic" asp-action="Enrollments">＋ Đăng ký học phần</a></div>
<div class="metric-grid"><div class="metric-card"><div class="metric-top"><span>Tổng sinh viên</span><span class="metric-icon lavender">♙</span></div><strong>@ViewBag.StudentCount.ToString("N0")</strong><small><b>+12%</b> so với học kỳ trước</small><div class="sparkline">▁▂▃▂▄▅▆▅▇</div></div><div class="metric-card"><div class="metric-top"><span>Học phần</span><span class="metric-icon blue-soft">▤</span></div><strong>@ViewBag.CourseCount.ToString("N0")</strong><small>Trong chương trình đào tạo</small><div class="sparkline blue-line">▁▂▂▄▃▅▄▇▆</div></div><div class="metric-card"><div class="metric-top"><span>Lớp học phần mở</span><span class="metric-icon green-soft">▦</span></div><strong>@ViewBag.ClassCount.ToString("N0")</strong><small><b>Đang nhận đăng ký</b></small><div class="sparkline green-line">▂▁▃▄▃▅▆▅▇</div></div><div class="metric-card"><div class="metric-top"><span>Lượt đăng ký</span><span class="metric-icon amber-soft">↗</span></div><strong>@ViewBag.EnrollmentCount.ToString("N0")</strong><small>Tổng trong hệ thống</small><div class="sparkline amber-line">▁▃▂▄▅▄▆▇▆</div></div></div>
<div class="dashboard-grid"><section class="surface-card"><div class="section-head"><div><h2>Đăng ký gần đây</h2><p>Cập nhật hoạt động mới nhất</p></div><a asp-controller="Academic" asp-action="Enrollments">Xem đăng ký <span>→</span></a></div><div class="table-responsive"><table class="table clean-table"><thead><tr><th>SINH VIÊN</th><th>HỌC PHẦN</th><th>LỚP</th><th>TRẠNG THÁI</th></tr></thead><tbody>@if(recent.Count==0){<tr><td colspan="4" class="empty-state">Chưa có lượt đăng ký nào.</td></tr>}@foreach(var x in recent){<tr><td><div class="person-cell"><div class="avatar">@(x.SinhVien?.HoTen?.FirstOrDefault())</div><div><b>@x.SinhVien?.HoTen</b><small>@x.SinhVien?.MaSinhVien</small></div></div></td><td><b>@x.LopHocPhan?.HocPhan?.TenHocPhan</b></td><td><span class="code-tag">@x.LopHocPhan?.MaLop</span></td><td><span class="status-pill @(x.TrangThai=="Đã hoàn thành"?"done":"active")">● @x.TrangThai</span></td></tr>}</tbody></table></div></section>
<section class="surface-card upcoming-card"><div class="section-head"><div><h2>Lớp học phần</h2><p>Lịch học kỳ hiện tại</p></div><a asp-controller="Academic" asp-action="Courses">Tất cả <span>→</span></a></div><div class="upcoming-list">@foreach(var x in sections){<div class="class-row"><div class="day-box"><b>T.@x.Thu</b><small>@(x.TietBatDau)–@(x.TietBatDau+x.SoTiet-1)</small></div><div class="class-info"><b>@x.HocPhan?.TenHocPhan</b><small>@x.MaLop · @x.Phong</small></div><span class="seat-count">@x.DangKys.Count/@x.SiSoToiDa</span></div>}</div></section></div>
<div class="ai-callout"><div class="ai-symbol">✧</div><div><b>Trợ lý học vụ UniFlow AI</b><p>Hỏi về điều kiện tiên quyết, lịch đăng ký và tiến độ học tập của bạn.</p></div><a class="button-light" asp-controller="Academic" asp-action="Assistant">Trò chuyện với AI <span>→</span></a></div>
