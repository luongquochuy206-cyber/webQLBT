@using QLBaiGuiXe.Models
@{ ViewData["Title"] = "Tổng quan"; var tickets = ViewBag.RecentTickets as List<PhieuSuCo> ?? new(); var upcoming = ViewBag.Upcoming as List<LichBaoTri> ?? new(); }
<div class="page-heading"><div><div class="eyebrow">TRUNG TÂM VẬN HÀNH</div><h1>Tổng quan bảo trì</h1><p>Theo dõi thiết bị, lịch bảo trì và sự cố trong tòa nhà.</p></div><a class="btn btn-primary" asp-controller="Maintenance" asp-action="CreateTicket">＋ Tạo phiếu sự cố</a></div>
<div class="stat-grid"><div class="stat-card"><span class="stat-icon blue">▦</span><div><small>Tổng thiết bị</small><strong>@ViewBag.DeviceCount</strong><span class="stat-note">Đang được quản lý</span></div></div><div class="stat-card"><span class="stat-icon amber">◷</span><div><small>Bảo trì 7 ngày tới</small><strong>@ViewBag.DueSoon</strong><span class="stat-note">Cần được theo dõi</span></div></div><div class="stat-card"><span class="stat-icon red">!</span><div><small>Sự cố đang mở</small><strong>@ViewBag.OpenTickets</strong><span class="stat-note">Chưa hoàn tất</span></div></div><div class="stat-card"><span class="stat-icon green">✓</span><div><small>Thiết bị cần sửa</small><strong>@ViewBag.BrokenDevices</strong><span class="stat-note">Trạng thái cần sửa chữa</span></div></div></div>
<div class="content-grid"><section class="panel"><div class="panel-head"><div><h2>Sự cố gần đây</h2><p>Các phiếu mới tiếp nhận</p></div><a asp-controller="Maintenance" asp-action="Tickets">Xem tất cả →</a></div><div class="table-responsive"><table class="table app-table"><thead><tr><th>Sự cố</th><th>Thiết bị</th><th>Mức độ</th><th>Trạng thái</th><th>Thời gian</th></tr></thead><tbody>@if(tickets.Count == 0){<tr><td colspan="5" class="empty-state">Chưa có phiếu sự cố. Tạo phiếu đầu tiên để bắt đầu.</td></tr>}@foreach(var x in tickets){<tr><td class="fw-semibold">@x.TieuDe</td><td>@x.ThietBi?.Ten</td><td><span class="badge-status @(x.MucDo == "Cao" ? "danger" : x.MucDo == "Trung bình" ? "warning" : "success")">@x.MucDo</span></td><td>@x.TrangThai</td><td>@x.NgayTao.ToString("dd/MM HH:mm")</td></tr>}</tbody></table></div></section>
<section class="panel"><div class="panel-head"><div><h2>Lịch sắp tới</h2><p>Bảo trì đã được lên kế hoạch</p></div><a asp-controller="Maintenance" asp-action="Schedule">Mở lịch →</a></div><div class="schedule-list">@if(upcoming.Count == 0){<div class="empty-state">Chưa có lịch bảo trì sắp tới.</div>}@foreach(var x in upcoming){<div class="schedule-item"><div class="date-tile"><b>@x.NgayDuKien.ToString("dd")</b><span>@x.NgayDuKien.ToString("MMM")</span></div><div><b>@x.ThietBi?.Ten</b><small>@x.NoiDung</small><small>@x.NhanVien</small></div></div>}</div></section></div>
<div class="ai-banner"><div class="ai-orb">✦</div><div><b>Trợ lý bảo trì AI</b><p>Tóm tắt lịch sử sự cố thiết bị và nhận gợi ý ưu tiên kiểm tra.</p></div><a class="btn btn-light" asp-controller="Maintenance" asp-action="Assistant">Mở trợ lý →</a></div>
